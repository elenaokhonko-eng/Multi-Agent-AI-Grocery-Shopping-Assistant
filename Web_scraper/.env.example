# Environment variables for the scraper application

# API Configuration
GROQ_API_KEY=yourapikey
GROQ_MODEL=llama-3.3-70b-versatile

# Database Configuration
MONGO_URI=mongodb://localhost:27017/
DATABASE_NAME=ecommerce_db

# Scraping Configuration
MAX_MARKDOWN_LENGTH=12000
CRAWL_TIMEOUT=30
PRUNING_THRESHOLD=0.48

# Rate Limiting
REQUEST_DELAY=1.0
MAX_RETRIES=3

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=data/scraper.log

# Output Configuration
SAVE_RAW_MARKDOWN=false
SAVE_JSON_OUTPUT=true

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=true
