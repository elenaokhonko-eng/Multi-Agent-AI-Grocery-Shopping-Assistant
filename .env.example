# Tensor Titans SLAIC 2025 - Global Environment Configuration Template
# ====================================================================
# Copy this file to .env and fill in your actual values

# API Keys (Required)
# -------------------
# Get your Groq API key from: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Optional: OpenAI API key for additional LLM options
OPENAI_API_KEY=sk-your_openai_api_key_here

# Database Configuration
# ----------------------
MONGODB_URI=mongodb+srv://yasirunipunbasnayake2_db_user:hFIS1XVxBmbaC5Ro@techtitans0.c5azljc.mongodb.net/
MONGODB_DATABASE=ecommerce_db
MONGODB_TIMEOUT=5000

# Application Configuration
# -------------------------
DEBUG_MODE=true
MAX_RESULTS_PER_KEYWORD=10
DEFAULT_BUDGET=5000
BUDGET_CURRENCY=LKR

# Server Configuration
# --------------------
# Python API Server
PYTHON_API_PORT=3004
PYTHON_API_HOST=0.0.0.0

# Node.js Backend Server
BACKEND_PORT=3001
BACKEND_HOST=localhost

# Frontend Development Server
FRONTEND_PORT=8080
FRONTEND_HOST=localhost

# LLM Configuration
# -----------------
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0

# Web Scraping Configuration
# ---------------------------
MAX_MARKDOWN_LENGTH=50000
CRAWL_TIMEOUT=30
PRUNING_THRESHOLD=0.3
REQUEST_DELAY=1.0
MAX_RETRIES=3

# Logging Configuration
# ---------------------
LOG_LEVEL=INFO
LOG_FILE=./data/application.log

# Security Configuration
# -----------------------
# Enable CORS for frontend integration
CORS_ENABLED=true
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Development Settings
# --------------------
FLASK_ENV=development
FLASK_DEBUG=false
NODE_ENV=development
