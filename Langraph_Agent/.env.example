# Langraph Agent Environment Configuration Template
# ================================================
# Copy this file to .env and fill in your actual values

# API Keys (Required)
# -------------------
GROQ_API_KEY=gsk_your_groq_api_key_here
OPENAI_API_KEY=sk-your_openai_api_key_here

# LLM Configuration
# -----------------
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0

# RAG Agent Configuration (Optional)
# -----------------------------------
RAG_INDEX_DIR=./rag/index
RAG_CORPUS_DIR=./rag/corpus
RAG_LLM_PROVIDER=groq
RAG_LLM=llama-3.1-8b-instant
RAG_EMBEDDINGS=hf:all-MiniLM-L6-v2

# MongoDB Configuration
# ---------------------
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DATABASE=ecommerce_db
MONGODB_TIMEOUT=5000

# Application Settings
# --------------------
MAX_RESULTS_PER_KEYWORD=10
DEBUG_MODE=true

# Web Scraper Integration
# -----------------------
WEB_SCRAPER_PATH=../Web_scraper

# Budget Settings
# ---------------
DEFAULT_BUDGET=5000
BUDGET_CURRENCY=LKR

# Delivery Settings
# -----------------
DEFAULT_DELIVERY_TIME=24
DELIVERY_TIME_UNIT=hours
